Thumbs.db
.DS_Store

# Frontend
/frontend/node_modules/
/frontend/dist/

# Flutter / mobile build outputs
/mobile/.dart_tool/
/mobile/build/
/mobile/.idea/

# Logs
*.log

# Local sqlite
*.sqlite3
